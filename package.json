{
  "name": "chatgpt-message-navigator",
  "version": "1.0.0",
  "private": true,
  "description": "Chat Navigator: a Chrome extension with a searchable side-panel navigator for the messages of the conversation open on chatgpt.com.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "pnpm typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "node e2e/extension.e2e.mjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@11.28.9"
}
